<!DOCTYPE html>
<html>
<head>
<title>My Online Shop</title>

<style>
body{
    font-family: Arial;
    margin:0;
    background:#f4f4f4;
}

header{
    background:#222;
    color:white;
    padding:20px;
    text-align:center;
}

nav{
    background:#ff9800;
    padding:10px;
    text-align:center;
}

nav a{
    color:white;
    margin:15px;
    text-decoration:none;
}

.products{
    display:flex;
    justify-content:center;
    gap:20px;
    flex-wrap:wrap;
    margin:30px;
}

.card{
    background:white;
    width:220px;
    padding:20px;
    text-align:center;
    border-radius:10px;
    box-shadow:0 0 10px gray;
}

.card img{
    width:150px;
    height:150px;
}

button{
    background:#28a745;
    color:white;
    border:none;
    padding:10px;
    cursor:pointer;
    border-radius:5px;
}

button:hover{
    background:#218838;
}

footer{
    background:#222;
    color:white;
    text-align:center;
    padding:15px;
}
</style>

</head>

<body>

<header>
<h1>🛒 JSD Online Shop</h1>
<p>Best Products At Best Price</p>
</header>

<nav>
<a href="#">Home</a>
<a href="#">Products</a>
<a href="#">Cart</a>
<a href="#">Contact</a>
</nav>


<section class="products">

<div class="card">
<img src="https://via.placeholder.com/150">
<h2>Mobile Phone</h2>
<p>₹15000</p>
<button>Add Cart</button>
</div>


<div class="card">
<img src="https://via.placeholder.com/150">
<h2>Laptop</h2>
<p>₹50000</p>
<button>Add Cart</button>
</div>


<div class="card">
<img src="https://via.placeholder.com/150">
<h2>Headphone</h2>
<p>₹2000</p>
<button>Add Cart</button>
</div>


<div class="card">
<img src="https://via.placeholder.com/150">
<h2>Smart Watch</h2>
<p>₹3000</p>
<button>Add Cart</button>
</div>

</section>


<footer>
<p>© 2026 JSD Online Shop | All Rights Reserved</p>
</footer>

</body>
</html>
